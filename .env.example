# Copy to .env (gitignored) or set as Worker secrets. Placeholder values only.

# --- uptime Worker (set with: wrangler secret put <NAME>) ---
CF_API_TOKEN=replace-with-cloudflare-api-token
DASH_PASSWORD=replace-with-board-password
GUARD_SECRET=replace-with-random-hex
TOKEN_KEY=replace-with-random-hex
# Shared secret for the LAN monitor agent (X-Monitor-Secret header)
MONITOR_SECRET=replace-with-random-hex

# --- LAN monitor agent (~/.config/monitor-agent/env on the agent host) ---
BOARD_URL=https://board.example.com
AGENT_NAME=lan-agent
